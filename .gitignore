# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignora segredos, mas mantém o template .env.example versionado
.env*
!.env.example

# supabase (estado local de link com o projeto remoto)
/supabase/.temp
/supabase/.branches

# vercel
.vercel

# editor/agent local
/.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# doc interno de gestao de acesso (nao distribuir ao aluno)
COMO-LIBERAR-ACESSO.md
